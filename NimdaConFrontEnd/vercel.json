{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://43.200.36.32/api/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "about.nimda.kr"
        }
      ],
      "destination": "/about/:path*"
    },
    {
      "source": "/((?!api|about).*|.*)",
      "destination": "/index.html"
    }
  ]
}