# Copy to .env only on an approved deployment host.
# Replace every CHANGE_ME value from an approved secret manager.

# Immutable backend image tag produced by CI (short commit SHA)
BACKEND_IMAGE_TAG=CHANGE_ME_COMMIT_SHA

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=nimda_con
MYSQL_USER=nimda
MYSQL_PASSWORD=CHANGE_ME
MYSQL_INNODB_BUFFER_POOL_SIZE=256M

# Redis
REDIS_PASSWORD=CHANGE_ME

# AWS S3
AWS_S3_BUCKET=CHANGE_ME
AWS_S3_REGION=ap-northeast-2
AWS_S3_ACCESS_KEY=CHANGE_ME
AWS_S3_SECRET_KEY=CHANGE_ME

# JWT (use a high-entropy value; never reuse a user password)
JWT_SECRET=CHANGE_ME

# SMTP
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
